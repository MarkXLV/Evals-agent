# ---------------------------------------------------------------------------
# Copy to .env and fill in. Nothing here is required for the mock dry-run.
# ---------------------------------------------------------------------------

# --- Frontier assistant + LLM judge (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
FRONTIER_MODEL=claude-sonnet-4-5
JUDGE_MODEL=claude-sonnet-4-5

# --- Open-source assistant -------------------------------------------------
# OSS_BACKEND: together | hf_router | hf_inference | mock
OSS_BACKEND=together
OSS_MODEL=Qwen/Qwen2.5-7B-Instruct-Turbo

# Together AI (OpenAI-compatible). https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=

# HuggingFace token, used by hf_router (OpenAI-compatible) and hf_inference.
# https://huggingface.co/settings/tokens
HF_TOKEN=

# --- search_web tool -------------------------------------------------------
# Leave blank to use the offline deterministic snapshot corpus (recommended
# for reproducible evals). Set to use live search in the chat UI.
TAVILY_API_KEY=

# --- Runtime knobs ---------------------------------------------------------
AGENT_TEMPERATURE=0.2
AGENT_MAX_TOKENS=800
MEMORY_MAX_TURNS=8
EVAL_CONCURRENCY=4
GUARDRAILS_ENABLED=false
