# Eval outputs. runs/ can get large (full traces per case), so it stays out of
# version control. reports/ is ignored EXCEPT the final deliverables, which are
# whitelisted below so the submitted results ship with the repo.
runs/
reports/*
!reports/evaluation.html
!reports/evaluation.json
!reports/evaluation.pdf
!reports/judge_quality.json
!reports/guardrail_ab.json
!reports/EVALUATION_SUMMARY.md
!reports/PDF_INSTRUCTIONS.txt
